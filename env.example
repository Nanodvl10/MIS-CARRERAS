# ---- Strava ----
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=pon_aqui_tu_client_secret
STRAVA_REFRESH_TOKEN=pon_aqui_tu_refresh_token

# ---- Cifrado ----
# La MISMA contrasena que pondras en la app (Ajustes -> Sincronizacion).
# Usa una larga, y no la reutilices de otro sitio.
SYNC_PASSPHRASE=cambia-esto-por-una-frase-larga

# ---- Publicacion ----
REPO_DIR=/opt/miscarreras/repo
SALIDA=/opt/miscarreras/repo/datos/entrenos.json
GIT_PUSH=1

# ---- Opciones ----
DIAS=60
MAX_ACTIVIDADES=40
INCLUIR_RUTA=1
